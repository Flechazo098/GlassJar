cabal-version:      3.0
name:               GlassJar
version:            0.1.0.0
synopsis:           Diff two JAR files and export the differences
description:
  GlassJar is a high-performance tool for diffing JAR files.
  It goes beyond simple binary comparisons to understand changes
  in class structures, resources, and manifests.
  .
  Features:
  - Fast MD5-based file change detection
  - Text, JSON, and HTML output formats
  - Colored terminal output

license:            MIT
license-file:       LICENSE
author:             Flechazo
maintainer:         2558755403@qq.com
category:           Tools
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  GlassJar
    other-modules:    GlassJar.Types
                    , GlassJar.Html
                    , GlassJar.Diff
                    , GlassJar.Internal
                    , GlassJar.Decompile
                    , GlassJar.Report
    build-depends:
        base                 ^>=4.18.3.0,
        zip-archive          >=0.4.3   && <0.5,
        cryptonite           >=0.30    && <0.31,
        memory               >=0.18    && <0.19,
        bytestring           >=0.11.5  && <0.13,
        text                 >=2.0     && <2.2,
        containers           >=0.6.7   && <0.7,
        ansi-terminal        >=1.0     && <1.1,
        aeson                >=2.2     && <2.3,
        directory            >=1.3.8   && <1.4,
        array                >=0.5.6   && <0.6,
        filepath             >=1.4     && <1.6,
        process              >=1.6     && <1.7,
        temporary            >=1.3     && <1.4,
        async                >=2.2     && <2.3,
        zlib                 >=0.7     && <0.8

    hs-source-dirs:   src
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
        DeriveGeneric

executable glassjar
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base                 ^>=4.18.3.0,
        GlassJar,
        optparse-applicative >=0.18    && <0.19,
        text                 >=2.0     && <2.2,
        bytestring           >=0.11.5  && <0.13

    hs-source-dirs:   app
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings

test-suite GlassJar-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base                 ^>=4.18.3.0,
        GlassJar,
        zip-archive          >=0.4.3   && <0.5,
        bytestring           >=0.11.5  && <0.13,
        text                 >=2.0     && <2.2,
        directory            >=1.3.8   && <1.4,
        filepath             >=1.4     && <1.6,
        temporary            >=1.3     && <1.4

    hs-source-dirs:   test
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings

